rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function perfil() {
      return firestore.get(
        /databases/(default)/documents/usuarios/$(request.auth.uid)
      ).data;
    }

    function activo() {
      return request.auth != null
        && firestore.exists(
          /databases/(default)/documents/usuarios/$(request.auth.uid)
        )
        && perfil().get('estado', '') == 'activo'
        && perfil().get('estadoUsuario', 'activo') == 'activo'
        && perfil().get('bloqueado', false) == false;
    }

    function puedeCargar(empleadoId, categoria) {
      let roles = perfil().get('roles', []);
      return activo() && (
        roles.hasAny(['administrador', 'talento_humano'])
        || perfil().get('empleadoId', '') == empleadoId
        || (roles.hasAny(['sst']) && categoria in ['sst', 'incapacidades'])
      );
    }

    function puedeLeer(empleadoId, categoria, documentoId) {
      let datos = firestore.get(
        /databases/(default)/documents/portal_documentos/$(documentoId)
      ).data;
      let roles = perfil().get('roles', []);
      return activo()
        && datos.get('empleadoId', '') == empleadoId
        && datos.get('categoria', '') == categoria
        && (
          roles.hasAny(['administrador', 'talento_humano'])
          || perfil().get('empleadoId', '') == empleadoId
          || (roles.hasAny(['sst']) && categoria in ['sst', 'incapacidades'])
        );
    }

    // Ruta: documentos/{empleadoId}/{categoria}/{documentoId}/{archivo}
    // El archivo se carga antes de crear los metadatos; la lectura exige metadatos coincidentes.
    match /documentos/{empleadoId}/{categoria}/{documentoId}/{archivo} {
      allow create: if puedeCargar(empleadoId, categoria)
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';

      allow read: if puedeLeer(empleadoId, categoria, documentoId);
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}