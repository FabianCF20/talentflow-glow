rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function perfil() {
      return firestore.get(
        /databases/(default)/documents/usuarios/$(request.auth.uid)
      ).data;
    }

    function activo() {
      return request.auth != null
        && firestore.exists(
          /databases/(default)/documents/usuarios/$(request.auth.uid)
        )
        && perfil().get('estado', '') == 'activo'
        && perfil().get('estadoUsuario', 'activo') == 'activo'
        && perfil().get('bloqueado', false) == false;
    }

    function autorizado(empleadoId, categoria) {
      let roles = perfil().get('roles', []);
      return activo() && (
        roles.hasAny(['administrador', 'talento_humano'])
        || perfil().get('empleadoId', '') == empleadoId
        || (roles.hasAny(['sst']) && categoria in ['sst', 'incapacidades'])
      );
    }

    // Ruta privada: documentos/{empleadoId}/{categoria}/{documentoId}/{archivo}
    // La ruta es la frontera de autorización; no se exponen URLs públicas.
    match /documentos/{empleadoId}/{categoria}/{documentoId}/{archivo} {
      allow read: if autorizado(empleadoId, categoria);

      // Solo creación: impide reemplazo y borrado. La metadata MIME no sustituye
      // un análisis antivirus del lado servidor.
      allow write: if resource == null
        && request.resource != null
        && autorizado(empleadoId, categoria)
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}