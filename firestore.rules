rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function perfilRef() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }

    function tienePerfil() {
      return autenticado() && exists(perfilRef());
    }

    function perfil() {
      return get(perfilRef()).data;
    }

    // Un perfil inactivo o bloqueado no conserva permisos, aunque mantenga roles.
    function activo() {
      return tienePerfil()
        && perfil().get('estado', 'activo') == 'activo'
        && !(perfil().get('estadoUsuario', 'activo') in ['inactivo', 'bloqueado', 'pendiente']);
    }

    function roles() {
      return activo() && perfil().get('roles', []) is list
        ? perfil().get('roles', [])
        : [];
    }

    function tieneRol(rol) {
      return rol in roles();
    }

    function tieneAlguno(lista) {
      return roles().hasAny(lista);
    }

    function esAdmin() {
      return tieneRol('administrador');
    }

    function esRrhh() {
      return tieneAlguno(['administrador', 'talento_humano']);
    }

    function esNomina() {
      return tieneAlguno(['administrador', 'nomina', 'contabilidad']);
    }

    function esSst() {
      return tieneAlguno(['administrador', 'sst', 'talento_humano']);
    }

    function esMando() {
      return tieneAlguno([
        'administrador', 'gerente_general', 'director', 'jefe',
        'supervisor', 'talento_humano'
      ]);
    }

    function miEmpleadoId() {
      return activo() ? perfil().get('empleadoId', '') : '';
    }

    function esMiEmpleado(empleadoId) {
      return activo() && empleadoId != '' && empleadoId == miEmpleadoId();
    }

    function actorPropio(datos) {
      return activo() && datos.get('usuarioUid', '') == request.auth.uid;
    }

    function documentoPermitido(datos) {
      return activo() && (esRrhh()
        || esMiEmpleado(datos.get('empleadoId', ''))
        || (tieneRol('sst') && datos.get('categoria', '') in ['sst', 'incapacidades']));
    }

    function puedeGestionarDocumento(datos) {
      return activo() && (esRrhh()
        || (tieneRol('sst') && datos.get('categoria', '') in ['sst', 'incapacidades']));
    }

    /* Cuentas: el rol administrador solo puede ser concedido por un administrador existente. */
    match /usuarios/{uid} {
      allow read: if activo() && (request.auth.uid == uid || esRrhh());

      // El alta pública, si se habilita, solo puede crear una cuenta de empleado.
      // El primer administrador debe provisionarse manualmente desde un entorno confiable.
      allow create: if esAdmin()
        || (esRrhh()
          && request.resource.data.get('roles', []) == ['empleado']
          && request.resource.data.get('estado', 'activo') == 'activo')
        || (autenticado()
          && request.auth.uid == uid
          && request.resource.data.get('roles', []) == ['empleado']
          && request.resource.data.get('empleadoId', '') == ''
          && request.resource.data.get('email', '') == request.auth.token.email
          && request.resource.data.get('estado', 'activo') == 'activo'
          && request.resource.data.keys().hasOnly([
            'id', 'email', 'nombres', 'apellidos', 'roles', 'estado', 'creadoEn'
          ]));

      // RRHH puede administrar datos de la cuenta, pero nunca conceder/cambiar roles.
      // Solo un administrador puede modificar roles o asignar privilegios.
      allow update: if esAdmin()
        || (esRrhh()
          && request.resource.data.get('roles', []) == resource.data.get('roles', [])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'nombres', 'apellidos', 'estado', 'estadoUsuario',
            'empleadoId', 'nivelJerarquico', 'ultimoAcceso'
          ]))
        || (activo()
          && request.auth.uid == uid
          && request.resource.data.get('roles', []) == resource.data.get('roles', [])
          && request.resource.data.get('empleadoId', '') == resource.data.get('empleadoId', '')
          && request.resource.data.get('estado', 'activo') == resource.data.get('estado', 'activo')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'nombres', 'apellidos', 'ultimoAcceso', 'telefono', 'celular', 'direccion'
          ]));

      // Las cuentas se inactivan; no se borran físicamente desde el cliente.
      allow delete: if false;
    }

    match /configuracion/{docId} {
      allow read: if activo() && (esAdmin() || tieneRol('talento_humano'));
      allow write: if esAdmin() && activo();
    }

    /* Auditoría: registros autoatribuidos e inmutables desde el cliente. */
    match /auditoria/{docId} {
      allow read: if activo() && (esAdmin() || tieneRol('gerente_general'));
      allow create: if actorPropio(request.resource.data);
      allow update, delete: if false;
    }

    match /accesos_datos/{docId} {
      allow read: if esRrhh() && activo();
      allow create: if actorPropio(request.resource.data)
        && (esRrhh() || tieneRol('sst')
          || esMiEmpleado(request.resource.data.get('empleadoId', '')));
      allow update, delete: if false;
    }

    match /firmas_documentos/{codigo} {
      allow read: if documentoPermitido(resource.data);
      allow create: if documentoPermitido(request.resource.data);
      allow update, delete: if false;
    }

    /* Datos maestros no salariales. */
    match /org_niveles/{docId}         { allow read: if activo(); allow write: if esRrhh() && activo(); }
    match /org_areas/{docId}           { allow read: if activo(); allow write: if esRrhh() && activo(); }
    match /org_dependencias/{docId}    { allow read: if activo(); allow write: if esRrhh() && activo(); }
    match /org_centros_trabajo/{docId} { allow read: if activo(); allow write: if esRrhh() && activo(); }
    match /org_centros_costo/{docId}   { allow read: if activo() && (esRrhh() || esNomina()); allow write: if (esRrhh() || esNomina()) && activo(); }
    match /org_cargos/{docId}          { allow read: if esRrhh() || esNomina(); allow write: if esRrhh() && activo(); }

    // Esta colección contiene salario: no se expone a todos los usuarios autenticados.
    match /org_empleados/{docId} {
      allow read: if esRrhh() || esNomina();
      allow create, update: if esRrhh() && activo();
      allow delete: if false;
    }

    match /empleados_rrhh/{empleadoId} {
      allow read: if esRrhh() || esNomina() || esMiEmpleado(empleadoId);
      allow create, update: if esRrhh() && activo();
      allow delete: if false;
    }

    // El expediente incluye datos personales, familiares, bancarios y de seguridad social.
    match /expedientes/{empleadoId} {
      allow read: if esRrhh() || esMiEmpleado(empleadoId);
      allow create, update: if esRrhh() && activo();
      allow delete: if false;
    }

    match /eventos_hoja_vida/{docId} {
      allow read: if esRrhh() || esMiEmpleado(resource.data.get('empleadoId', ''));
      allow create: if esRrhh() && activo();
      allow update, delete: if false;
    }

    /* Nómina y salarios. */
    match /nomina_periodos/{docId} {
      allow read: if esNomina() || (esMando() && activo());
      allow write: if esNomina() && activo();
    }
    match /nomina_recurrentes/{docId} {
      allow read, write: if esNomina() && activo();
    }
    match /nomina_liquidaciones/{docId} {
      allow read: if esNomina() || esMiEmpleado(resource.data.get('empleadoId', ''));
      allow create, update: if esNomina() && activo();
      allow delete: if false;
    }

    /* SST: información médica y laboral restringida por función y titular. */
    match /sst_examenes/{docId} {
      allow read: if esSst() || esMiEmpleado(resource.data.get('empleadoId', ''));
      allow write: if esSst() && activo();
    }
    match /sst_accidentes/{docId} {
      allow read: if esSst();
      allow write: if esSst() && activo();
    }
    match /sst_capacitaciones/{docId} {
      allow read: if activo();
      allow write: if esSst() && activo();
    }
    match /sst_tallas/{empleadoId} {
      allow read: if esSst() || esMiEmpleado(empleadoId);
      allow create, update: if (esSst() || esMiEmpleado(empleadoId)) && activo();
      allow delete: if false;
    }
    match /sst_entregas/{docId} {
      allow read: if esSst() || esMiEmpleado(resource.data.get('empleadoId', ''));
      allow write: if esSst() && activo();
    }
    match /sst_formularios/{docId} {
      allow read: if activo();
      allow write: if esSst() && activo();
    }
    match /sst_respuestas/{docId} {
      allow read: if esSst() || esMiEmpleado(resource.data.get('empleadoId', ''));
      allow create: if activo() && esMiEmpleado(request.resource.data.get('empleadoId', ''));
      allow update: if esSst() && activo();
      allow delete: if false;
    }

    /* Operaciones. Las altas del portal deben pertenecer al usuario autenticado. */
    match /op_solicitudes/{docId} {
      allow read: if esMando() || esRrhh() || esMiEmpleado(resource.data.get('empleadoId', ''));
      allow create: if activo() && esMiEmpleado(request.resource.data.get('empleadoId', ''));
      allow update: if (esMando() || esRrhh()) && activo();
      allow delete: if false;
    }
    match /op_incapacidades/{docId} {
      allow read: if esRrhh() || esSst() || esMiEmpleado(resource.data.get('empleadoId', ''));
      allow create, update: if (esRrhh() || esSst()) && activo();
      allow delete: if false;
    }
    match /op_asistencia/{docId} {
      allow read: if esMando() || esMiEmpleado(resource.data.get('empleadoId', ''));
      allow create, update: if esMando() && activo();
      allow delete: if false;
    }
    match /op_horas_extras/{docId} {
      allow read: if esMando() || esNomina() || esMiEmpleado(resource.data.get('empleadoId', ''));
      allow create: if activo() && esMiEmpleado(request.resource.data.get('empleadoId', ''));
      allow update: if (esMando() || esNomina()) && activo();
      allow delete: if false;
    }
    match /op_novedades/{docId} {
      allow read: if esMando() || esNomina() || esRrhh();
      allow write: if (esRrhh() || esNomina()) && activo();
    }

    /* Gestión disciplinaria. */
    match /disc_incidencias/{docId} {
      allow read: if esRrhh() || esMando();
      allow write: if (esRrhh() || esMando()) && activo();
    }
    match /disc_observaciones/{docId} {
      allow read: if esRrhh() || esMando();
      allow write: if (esRrhh() || esMando()) && activo();
    }
    match /disc_evaluaciones/{docId} {
      allow read: if esRrhh() || esMando() || esMiEmpleado(resource.data.get('empleadoId', ''));
      allow write: if (esRrhh() || esMando()) && activo();
    }
    match /disc_respuestas/{docId} {
      allow read: if esRrhh() || esMando() || esMiEmpleado(resource.data.get('empleadoId', ''));
      allow create: if activo() && esMiEmpleado(request.resource.data.get('empleadoId', ''));
      allow update: if (esRrhh() || esMando()) && activo();
      allow delete: if false;
    }

    /* Portal del empleado. */
    match /portal_solicitudes/{docId} {
      // Las solicitudes de actualización de datos personales solo las revisa RRHH.
      allow read: if esRrhh() || esMiEmpleado(resource.data.get('empleadoId', ''));
      allow create: if activo() && esMiEmpleado(request.resource.data.get('empleadoId', ''));
      allow update: if esRrhh() && activo();
      allow delete: if false;
    }

    match /portal_documentos/{docId} {
      allow read: if documentoPermitido(resource.data);
      allow create: if puedeGestionarDocumento(request.resource.data)
        || (activo() && esMiEmpleado(request.resource.data.get('empleadoId', '')));
      allow update: if (puedeGestionarDocumento(resource.data)
          && puedeGestionarDocumento(request.resource.data)
          && request.resource.data.get('empleadoId', '') == resource.data.get('empleadoId', ''))
        || (activo() && esMiEmpleado(resource.data.get('empleadoId', ''))
          && request.resource.data.get('empleadoId', '') == resource.data.get('empleadoId', '')
          && request.resource.data.get('categoria', '') == resource.data.get('categoria', ''));
      allow delete: if false;
    }

    match /portal_certificados/{docId} {
      allow read: if esRrhh() || esMiEmpleado(resource.data.get('empleadoId', ''));
      allow create: if activo() && (esRrhh()
        || esMiEmpleado(request.resource.data.get('empleadoId', '')));
      allow update: if esRrhh() && activo();
      allow delete: if false;
    }

    // Cierre por defecto: toda colección no declarada queda denegada para no administradores.
    match /{coleccion}/{docId} {
      allow read, write: if esAdmin() && activo();
    }
  }
}